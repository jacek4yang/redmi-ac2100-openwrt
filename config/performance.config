# Performance / observability / optional-feature layer.
#
# Appended after config/base.config by scripts/prepare.sh when building the
# "full" flavor (the default CI build). Building with base.config alone
# produces the lean fallback variant.
#
# Everything here is either (a) a diagnostic tool justified in
# docs/benchmarks.md, or (b) an optional feature that ships installed but NOT
# auto-configured (see docs/performance.md). Nothing in this file enables a
# runtime fast path by itself; runtime toggles live in files/etc/uci-defaults/.

# ---- Observability / benchmarking -------------------------------------------
CONFIG_PACKAGE_iperf3=y          # wired + Wi-Fi throughput methodology
CONFIG_PACKAGE_tcpdump-mini=y    # packet capture (mini variant saves ~1 MB vs full)
CONFIG_PACKAGE_ethtool=y         # NIC ring/driver/offload inspection
CONFIG_PACKAGE_conntrack=y       # conntrack table inspection (from conntrack-tools)
CONFIG_PACKAGE_htop=y            # per-core CPU/softirq visibility under load

# ---- Optional features (installed, disabled until configured) ----------------
# Tailscale: package + init script, but the service is not started and no
# auth key exists in the image. See docs/tailscale.md. Single tailscaled
# binary + CLI symlink (stripped by the build system); notable flash/RAM cost,
# justified by the CGNAT reality of the Telecom PPPoE WAN (docs/tailscale.md).
CONFIG_PACKAGE_tailscale=y

# SmartDNS + LuCI app: installed for optional selective/parallel upstream DNS.
# NOT bound as the system DNS by default; dnsmasq stays the LAN resolver.
# See docs/performance.md before enabling.
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y

# Deliberately NOT included (evaluated, rejected; see docs/performance.md):
#   SQM / kmod-sched-cake / luci-app-sqm  - conflicts with hw flow offload fast path
#   irqbalance                            - no MT7621-specific evidence; measure first
#   samba4 / minidlna / usb-storage       - out of scope for a lean router
#   wpad-full / hostapd extras            - basic-mbedtls variant is sufficient
