# Base OpenWrt configuration seed (diffconfig format) for the custom
# Redmi Router AC2100 firmware.
#
# Applied by scripts/prepare.sh, expanded by `make defconfig`.
# Pinned upstream: OpenWrt v25.12.5 (commit f0a60eee2fe051741c643ea6118718aae1ef17fb).
#
# This file intentionally contains ONLY the minimal device/core selection.
# It is the canonical config of the full-Buildroot pipeline (source-build.yml).
# User-facing package-set variants (base/full) are produced by the
# ImageBuilder pipeline from config/packages-*.list - no source recompile.
# Runtime tuning is NOT here; it is applied at first boot via
# files/etc/uci-defaults/ (see docs/performance.md for rationale).

# ---- Device identity (DO NOT CHANGE) ---------------------------------------
# Xiaomi Redmi Router AC2100 (six-antenna model, RM2100).
# NOT Xiaomi Mi Router AC2100 - that is a different device with a different
# DTS and image layout; mixing them bricks the flash layout.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_redmi-router-ac2100=y
CONFIG_TARGET_BOARD="ramips"

# ---- Management -------------------------------------------------------------
# LuCI web UI (pulls in luci-base, uhttpd, rpcd, luci-mod-network/status/...).
CONFIG_PACKAGE_luci=y

# ---- WAN / IPv4 -------------------------------------------------------------
# PPPoE + NAT. ppp is part of the default router package set on ramips, but we
# pin it explicitly because PPPoE WAN is a hard requirement of this firmware.
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ---- IPv6 (standards-compliant baseline, see docs/ipv6-design.md) -----------
# DHCPv6 client (WAN side, for IA_NA/IA_PD) and the RA/DHCPv6 server (LAN
# side). These match the OpenWrt default router set; pinned explicitly because
# correct native IPv6 is a design goal.
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# firewall4 / nftables, dropbear SSH, dnsmasq, wpad-basic-mbedtls and the
# device Wi-Fi packages (kmod-mt7603, kmod-mt7615-firmware) are already part
# of the OpenWrt default package set for this device profile and need no
# explicit lines.

# ---- Recovery/netboot image ------------------------------------------------------
# Also emit the RAM-only initramfs kernel image (uImage via the device's
# uimage-lzma-loader recipe). The stock U-Boot ships tftpboot + bootm with
# boot_wait=on and uart_en=1 (see docs/stock-flash-layout.md), so this image is
# the intended zero-flash hardware-validation vehicle. Validated in CI.
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# ---- Build hygiene -----------------------------------------------------------
# Content-addressed compiler cache (safe to cache across CI runs; the cache is
# keyed and never shares partial build state).
# CONFIG_CCACHE's prompt is gated on DEVEL (config/Config-devel.in:136 at the
# pinned commit), so kconfig forces it to n without CONFIG_DEVEL=y - a lone
# CONFIG_CCACHE=y here was silently dropped by defconfig (observed: no ccache
# in any build log, empty cache dir on runs 35452208528/35460747904/35464072806).
# With both set, rules.mk exports CCACHE_DIR=$(TOPDIR)/.ccache by default -
# exactly the path source-build.yml caches. Do NOT set CCACHE_DIR via workflow
# env: rules.mk's `export CCACHE_DIR:=` overrides the environment.
CONFIG_DEVEL=y
CONFIG_CCACHE=y
